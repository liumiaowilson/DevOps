#!/bin/bash
PIDFILE="$HOME/.edge-debug-profile/.pid"

if [ ! -f "$PIDFILE" ]; then
  echo "No PID file found — debug Edge may not be running"
  exit 1
fi

PID=$(cat "$PIDFILE")
if kill -0 "$PID" 2>/dev/null; then
  kill "$PID"
  echo "Debug Edge stopped (PID $PID)"
else
  echo "Debug Edge process (PID $PID) is not running"
fi
rm -f "$PIDFILE"
